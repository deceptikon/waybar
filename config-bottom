[
  {
    "name": "bar-bottom",
    "layer": "top",
    "position": "bottom",
    "reload_style_on_change": true,
    "height": 20,
    "fixed-center": true,
    "modules-right": [
      "custom/ollama",
      "custom/llama",
      "custom/checkupdates",
      "custom/recorder",
      "custom/fnlock"
    ],
    "modules-center": [
    ],
    "modules-left": [
      "tray"
    ],
    "include": [
    "modules-vc.json"

    ],
"ext/workspaces": {
	"format": "{name}: {icon}",
	"on-click": "activate",
	"format-icons": {
		"Workspace 1": "",
		"Workspace 2": "",
		"Workspace 3": "",
		"Workspace 4": "",
		"active": "",
		"default": ""
	},
	"sort-by-id": true
},
"custom/checkupdates": {
    "exec": "~/.config/waybar/scripts/utils/checkupdates.sh",
    "return-type": "json",
    "interval": 3600,
    "format": "{}",
    "on-click": "wezterm -e ~/.config/waybar/scripts/modules/run-updates.sh",
    "signal": 8
  },
    "sway/workspaces#bottom": {
      "disable-scroll": false,
      "all-outputs": false,
      "format": "{icon} ",
      "active-only": true,
      "format-icons": {
        "0": "",
        "1": ": I",
        "2": ": II",
        "3": ": III",
        "4": ": IV",
        "5": ": V",
        "urgent": "",
        "active": "",
        "default": ""
      },
      "persistent-workspaces": {
        "0": [],
        "1": ["eDP-1", "HDMI-A-1"],
        "2": ["HDMI-A-1"]
      }
    },
    "tray": {
      "icon-size": 16,
      "spacing": 7,
      "icons": {
        "blueman": "bluetooth",
        "Telegram": "telegram"
      }
    }
  }
]
