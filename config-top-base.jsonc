{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "modules-left": [
    "custom/wifi",
    "bluetooth",
    "group/audio",
    "custom/lang"
  ],
  "modules-center": [
    "group/top-center"
  ],
  "modules-right": [
    "group/bright",
    "custom/keylight",
    "battery"
  ],
  "include": [
    "modules-top-shared.json",
    "modules-peripherals.json"
  ],
  "custom/lang": {
    "exec": "~/.config/waybar/scripts/modules/lang-indicator.sh",
    "interval": 1,
    "format": "{}",
    "return-type": "json"
  },
  "group/top-center": {
    "orientation": "vertical",
    "modules": [
      "clock#date",
      "group/titlebox-row",
      "sway/mode"
    ]
  },
  "custom/toggle-vert-lite": {
    "format": "󰨞",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/utils/toggle-vert-lite.sh",
    "interval": 86400
  }
}
