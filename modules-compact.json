{
  "custom/compact-gpu": {
    "exec": "~/.config/waybar/scripts/modules/tail-feed.sh compact-gpu",
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5,
    "on-click": "gpustat",
    "on-right-click": "nvtop"
  },
  "custom/compact-cpu": {
    "exec": "~/.config/waybar/scripts/modules/tail-feed.sh compact-cpu",
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5,
    "on-click": "htop",
    "on-right-click": "gnome-system-monitor"
  },
  "custom/compact-ram": {
    "exec": "~/.config/waybar/scripts/modules/tail-feed.sh compact-ram",
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5,
    "on-click": "gnome-system-monitor",
    "on-right-click": "free -h"
  },
  "custom/compact-ssd": {
    "exec": "~/.config/waybar/scripts/modules/tail-feed.sh compact-ssd",
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5,
    "on-click": "gnome-disks",
    "on-right-click": "lsblk"
  }
}
