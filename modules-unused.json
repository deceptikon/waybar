{
  "_archive_note": "Modules removed from active bar configs. Review before permanent deletion.",

  "sway/workspaces": {
    "disable-scroll": false,
    "enable-bar-scroll": true,
    "disable-auto-back-and-forth": true,
    "smooth-scrolling-threshold": 20,
    "disable-scroll-wraparound": false,
    "format": ". {icon} <sub>{value}</sub> .",
    "format-icons": {
      "1": "\uf120",
      "2": "\uf268",
      "3": "\uf121",
      "4": "\uf1bc",
      "5": "\uf075",
      "focused": "\uf192",
      "urgent": "\uf06a",
      "active": "\uf192",
      "default": "\uf111"
    },
    "sort-by-number": true,
    "persistent_workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "network#qwi": {
    "format": "  ",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "format-icons": [
      "\udb80\udf5f",
      "\udb80\udf62",
      "\udb80\udf65",
      "\udb80\udf68",
      "\udb80\udf6b",
      "\udb80\udf6e"
    ]
  },
  "group/qwen-network": {
    "orientation": "horizontal",
    "modules": [
      "network#qwi",
      "custom/qwen-wifi-info"
    ]
  },
  "custom/qwen-wifi-info": {
    "exec": "~/.config/waybar/scripts/network/wifi-info.sh",
    "interval": 2,
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5,
    "on-click": "nm-connection-editor",
    "on-right-click": "nm-applet --indicator"
  },

  "custom/compact-netfan": {
    "exec": "tail -F ~/.config/waybar/feeds/compact-netfan.json",
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5
  },

  "custom/qwen-asus-icon": { "format": "  " },
  "group/qwen-asus": {
    "orientation": "horizontal",
    "modules": ["custom/qwen-asus-icon", "custom/qwen-asus"]
  },
  "custom/qwen-asus": {
    "exec": "echo '{\"text\":\"\",\"class\":\"good\"}'",
    "interval": 3600,
    "format": "{}",
    "return-type": "json",
    "justify": "center",
    "align": 0.5,
    "tooltip": "ASUS/profile module stubbed (out of sysmon scope)"
  },

  "removed_reference": "custom/TURNEDOFF_powerbtn was dropped from config-top/modules-right because no matching module definition exists",

  "tray": {
    "icon-size": 20,
    "spacing": 10,
    "_note": "Tray definition from config-top-base.jsonc; config-bottom defines its own tray"
  }
}
