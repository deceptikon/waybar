{
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " <sup>󰒳</sup>",
      "deactivated": "󰾪 <sup>󰒲</sup>"
    }
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": " ",
      "power-saver": "󱤅"
    }
  },
  "custom/dunst": {
    "exec": "~/.config/waybar/scripts/utils/dunst.sh refresh",
    "return-type": "json",
    "interval": 1000,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/utils/dunst.sh",
    "signal": 9
  },
  "custom/recorder": {
    "format": "{}",
    "interval": "once",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/modules/recorder-status.sh",
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/utils/capturer.sh",
    "on-right-click": "~/.config/waybar/scripts/modules/run-and-signal.sh SIGRTMIN+8 pkill -INT wf-recorder",
    "tooltip": false
  },
  "custom/fnlock": {
    "exec": "~/.config/waybar/scripts/utils/fn-lock.sh refresh",
    "return-type": "json",
    "signal": 10,
    "on-click": "/usr/local/bin/toggle_fn_lock.sh"
  },
  "custom/ext-display": {
    "exec": "~/.config/waybar/scripts/utils/ext-display.sh refresh",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "on-click": "~/.config/waybar/scripts/utils/ext-display.sh",
    "signal": 11
  },
  "custom/llama": {
    "exec": "~/.config/waybar/scripts/utils/llama-server.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "signal": 22,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/feeds/llama-menu.xml",
    "menu-actions": {
      "start": "~/.config/waybar/scripts/utils/llama-server.sh start",
      "stop": "~/.config/waybar/scripts/utils/llama-server.sh stop",
      "restart": "~/.config/waybar/scripts/utils/llama-server.sh restart"
    }
  },
  "custom/ollama": {
    "exec": "~/.config/waybar/scripts/modules/ollama-status.sh",
    "interval": 5,
    "format": "{}",
    "return-type": "json"
  },
  "custom/profile": {
    "exec": "~/.config/waybar/scripts/utils/profile-indicator.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "on-click": "asusctl profile next"
  },
  "custom/powerbtn": {
    "exec": "~/.config/waybar/scripts/modules/uptime-widget.sh",
    "interval": 60,
    "format": "{}",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/feeds/powermenu.xml",
    "menu-actions": {
      "shutdown": "loginctl shutdown",
      "reboot": "loginctl reboot",
      "suspend": "loginctl suspend",
      "": "loginctl hibernate"
    }
  }
}
